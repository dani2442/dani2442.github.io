        <mxCell id="XZhYp0Dp_hmtZWfRll8S-21" value="diffusion stopped on exit" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#808080;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
