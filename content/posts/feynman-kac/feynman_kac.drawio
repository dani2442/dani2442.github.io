        <mxCell id="XZhYp0Dp_hmtZWfRll8S-17" value="\( \begin{cases}dX_s=b(X_s)ds+\sigma(X_s)dW_s\\ X_t=x\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="660" y="80" width="230" height="60" as="geometry" />
