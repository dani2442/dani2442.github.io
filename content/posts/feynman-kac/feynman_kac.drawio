        <mxCell id="h-rep" value="Representation" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=15;fontStyle=1" parent="1" vertex="1">
          <mxGeometry x="910" y="40" width="310" height="40" as="geometry" />
        </mxCell>
        <mxCell id="name-1" value="&lt;b&gt;Linear parabolic&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="80" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eq-1" value="\( \begin{cases}\partial_t u + \mathcal L u - Vu + f = 0 &amp;amp; \text{in } (0,T)\times\mathbb R^d\\ u(T,\cdot)=g &amp;amp; \text{in } \mathbb R^d\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="200" y="80" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="desc-1" value="diffusion" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#808080;" parent="1" vertex="1">
          <mxGeometry x="530" y="80" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sde-1" value="\( \begin{cases}dX_s=b(X_s)ds+\sigma(X_s)dW_s\\ X_t=x\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="660" y="80" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rep-1" value="\( \begin{aligned}u(t,x)=\mathbb E_x\Big[&amp;amp;e^{-\int_t^T V}g(X_T)+\int_t^T\! e^{-\int_t^s V}f(s,X_s)ds\,\Big]\end{aligned} \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="920" y="80" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="name-2" value="&lt;b&gt;Linear elliptic&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="140" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eq-2" value="\( \begin{cases}\mathcal L u - Vu + f = 0 &amp;amp; \text{in } \Omega\\ u=g &amp;amp; \text{on } \partial\Omega\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="200" y="140" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="desc-2" value="diffusion stopped on exit" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#808080;" parent="1" vertex="1">
          <mxGeometry x="530" y="140" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sde-2" value="\( \begin{cases}dX_t=b(X_t)dt+\sigma(X_t)dW_t\\ X_0=x\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="660" y="140" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rep-2" value="\( \begin{aligned}u(x)=\mathbb E_x\Big[&amp;amp;e^{-\int_0^\tau V}g(X_\tau)+\int_0^\tau\! e^{-\int_0^t V}f(X_t)dt\Big]\end{aligned} \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="920" y="140" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="name-3" value="&lt;b&gt;Semilinear parabolic&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="200" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eq-3" value="\( \begin{cases}\partial_t u + \mathcal L u + f(t,x,u,\sigma^\top\nabla u) = 0 &amp;amp; \text{in } (0,T)\times\mathbb R^d\\ u(T,\cdot)=g &amp;amp; \text{in } \mathbb R^d\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="200" y="200" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="desc-3" value="backward SDE run from the exit time along the diffusion" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#808080;" parent="1" vertex="1">
          <mxGeometry x="530" y="200" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sde-3" value="\( \begin{cases}dY_s=-f(s,X_s,Y_s,Z_s)ds+Z_s\cdot dW_s\\ Y_T=g(X_T),\quad Z_s=\sigma^\top\nabla u(s,X_s)\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="660" y="200" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rep-3" value="\( u(t,x)=Y_t \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="920" y="200" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="name-4" value="&lt;b&gt;Semilinear elliptic&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="260" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eq-4" value="\( \begin{cases}\mathcal L u + f(x,u,\sigma^\top\nabla u) = 0 &amp;amp; \text{in } \Omega\\ u=g &amp;amp; \text{on } \partial\Omega\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="200" y="260" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="desc-4" value="backward SDE run from the exit time along the diffusion" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#808080;" parent="1" vertex="1">
          <mxGeometry x="530" y="260" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sde-4" value="\( \begin{cases}dY_t=-f(X_t,Y_t,Z_t)dt+Z_t\cdot dW_t\\ Y_\tau=g(X_\tau),\quad Z_t=\sigma^\top\nabla u(X_t)\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="660" y="260" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rep-4" value="\( u(x)=Y_0 \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="920" y="260" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="name-5" value="&lt;b&gt;Fokker–Planck&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="320" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eq-5" value="\( \begin{cases}\partial_t \rho = \mathcal L^{*}\rho &amp;amp; \text{in } (0,T)\times\mathbb R^d\\ \rho(0,\cdot)=\mu &amp;amp; \text{in } \mathbb R^d\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="200" y="320" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="desc-5" value="diffusion from a random start" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#808080;" parent="1" vertex="1">
          <mxGeometry x="530" y="320" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sde-5" value="\( \begin{cases}dX_t=b(X_t)dt+\sigma(X_t)dW_t\\ X_0\sim\mu\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="660" y="320" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rep-5" value="\( \rho_t=\mathrm{Law}(X_t) \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="920" y="320" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="name-6" value="&lt;b&gt;Principal eigenvalue&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="380" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eq-6" value="\( \begin{cases}\mathcal L \phi - V\phi = -\lambda_1\phi &amp;amp; \text{in } \Omega\\ \phi=0 &amp;amp; \text{on } \partial\Omega\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="200" y="380" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="desc-6" value="diffusion stopped on exit" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#808080;" parent="1" vertex="1">
          <mxGeometry x="530" y="380" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sde-6" value="\( \begin{cases}dX_t=b(X_t)dt+\sigma(X_t)dW_t\\ X_0=x\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="660" y="380" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rep-6" value="\( \lambda_1=-\lim_{t\to\infty}\tfrac1t\log\mathbb E_x\big[e^{-\int_0^t V}\mathbf 1_{\{\tau&amp;gt;t\}}\big] \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="920" y="380" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="name-7" value="&lt;b&gt;HJB&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" parent="1" vertex="1">
          <mxGeometry x="40" y="440" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="eq-7" value="\( \begin{cases}\partial_t u + \inf_{\alpha\in\mathcal A}\left\{\mathcal L^{\alpha}u + \ell(x,\alpha)\right\} = 0 &amp;amp; \text{in } (0,T)\times\mathbb R^d\\ u(T,\cdot)=h &amp;amp; \text{in } \mathbb R^d\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="200" y="440" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="desc-7" value="controlled diffusion" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#808080;" parent="1" vertex="1">
          <mxGeometry x="530" y="440" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="sde-7" value="\( \begin{cases}dX^\alpha_s=b(X^\alpha_s,\alpha_s)ds+\sigma(X^\alpha_s,\alpha_s)dW_s\\ X^\alpha_t=x\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="660" y="440" width="290" height="60" as="geometry" />
        </mxCell>
        <mxCell id="rep-7" value="\( \begin{aligned}u(t,x)=\inf_{\alpha}\mathbb E\Big[&amp;amp;\int_t^T\! \ell(X^\alpha_s,\alpha_s)ds+h(X^\alpha_T)\,\Big]\end{aligned} \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="920" y="440" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="QvVRoslQFuuTe3eO3aBH-1" value="\(&amp;nbsp;\mathcal{L}\varphi:=\tfrac12\operatorname{tr}\!\big(\sigma\sigma^\top\,D^2\varphi\big)+b\cdot\nabla\varphi \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;spacing=4;" parent="1" vertex="1">
          <mxGeometry x="985" y="-20" width="230" height="20" as="geometry" />
        </mxCell>
        <mxCell id="KCWNQB4Kuvf-Z07Os2uw-1" value="\(&amp;nbsp;\tau := \inf \{t\geq 0: X_t \not\in&amp;nbsp; \Omega\} \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="995" y="10" width="200" height="20" as="geometry" />
        </mxCell>
        <mxCell id="KCWNQB4Kuvf-Z07Os2uw-3" value="Generator" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="915" y="-20" width="60" height="20" as="geometry" />
        </mxCell>
        <mxCell id="KCWNQB4Kuvf-Z07Os2uw-4" value="Exit time" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=2" vertex="1" parent="1">
          <mxGeometry x="915" y="10" width="60" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
