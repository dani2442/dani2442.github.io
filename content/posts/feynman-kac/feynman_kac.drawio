        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-47" value="\( \begin{cases}dX^\alpha_s=b(X^\alpha_s,\alpha_s)ds+\sigma(X^\alpha_s,\alpha_s)dW_s\\ X^\alpha_t=x\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
