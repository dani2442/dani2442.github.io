        <mxCell id="XZhYp0Dp_hmtZWfRll8S-35" value="\( \begin{cases}\partial_t \rho = \mathcal L^{*}\rho &amp;amp; \text{in } (0,T)\times\mathbb R^d\\ \rho(0,\cdot)=\mu &amp;amp; \text{in } \mathbb R^d\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="200" y="320" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-36" value="diffusion from a random start" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#808080;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="530" y="320" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-37" value="\( \begin{cases}dX_t=b(X_t)dt+\sigma(X_t)dW_t\\ X_0\sim\mu\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="660" y="320" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-38" value="\( \rho_t=\mathrm{Law}(X_t) \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="920" y="320" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-39" value="&lt;b&gt;Principal eigenvalue&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="40" y="380" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-40" value="\( \begin{cases}\mathcal L \phi - V\phi = -\lambda_1\phi &amp;amp; \text{in } \Omega\\ \phi=0 &amp;amp; \text{on } \partial\Omega\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="200" y="380" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-41" value="diffusion stopped on exit" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#808080;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="530" y="380" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-42" value="\( \begin{cases}dX_t=b(X_t)dt+\sigma(X_t)dW_t\\ X_0=x\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="660" y="380" width="230" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-43" value="\( \lambda_1=-\lim_{t\to\infty}\tfrac1t\log\mathbb E_x\big[e^{-\int_0^t V}\mathbf 1_{\{\tau&amp;gt;t\}}\big] \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="920" y="380" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-44" value="&lt;b&gt;HJB&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="40" y="440" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-45" value="\( \begin{cases}\partial_t u + \inf_{\alpha\in\mathcal A}\left\{\mathcal L^{\alpha}u + \ell(x,\alpha)\right\} = 0 &amp;amp; \text{in } (0,T)\times\mathbb R^d\\ u(T,\cdot)=h &amp;amp; \text{in } \mathbb R^d\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
