        <mxCell id="XZhYp0Dp_hmtZWfRll8S-18" value="\( \begin{aligned}u(t,x)=\mathbb E_x\Big[&amp;amp;e^{-\int_t^T V}g(X_T)+\int_t^T\! e^{-\int_t^s V}f(s,X_s)ds\,\Big]\end{aligned} \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="920" y="80" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-19" value="&lt;b&gt;Linear elliptic&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="40" y="140" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-20" value="\( \begin{cases}\mathcal L u - Vu + f = 0 &amp;amp; \text{in } \Omega\\ u=g &amp;amp; \text{on } \partial\Omega\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="200" y="140" width="320" height="60" as="geometry" />
