        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-22" value="\( \begin{cases}dX_t=b(X_t)dt+\sigma(X_t)dW_t\\ X_0=x\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="660" y="140" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-23" value="\( \begin{aligned}u(x)=\mathbb E_x\Big[&amp;amp;e^{-\int_0^\tau V}g(X_\tau)+\int_0^\tau\! e^{-\int_0^t V}f(X_t)dt\Big]\end{aligned} \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="920" y="140" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-24" value="&lt;b&gt;Semilinear parabolic&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="40" y="200" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-25" value="\( \begin{cases}\partial_t u + \mathcal L u + f(t,x,u,\sigma^\top\nabla u) = 0 &amp;amp; \text{in } (0,T)\times\mathbb R^d\\ u(T,\cdot)=g &amp;amp; \text{in } \mathbb R^d\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="200" y="200" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-26" value="backward SDE run from the exit time along the diffusion" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#808080;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="530" y="200" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-27" value="\( \begin{cases}dY_s=-f(s,X_s,Y_s,Z_s)ds+Z_s\cdot dW_s\\ Y_T=g(X_T),\quad Z_s=\sigma^\top\nabla u(s,X_s)\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="660" y="200" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-28" value="\( u(t,x)=Y_t \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="920" y="200" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-29" value="&lt;b&gt;Semilinear elliptic&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="40" y="260" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-30" value="\( \begin{cases}\mathcal L u + f(x,u,\sigma^\top\nabla u) = 0 &amp;amp; \text{in } \Omega\\ u=g &amp;amp; \text{on } \partial\Omega\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="200" y="260" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-31" value="backward SDE run from the exit time along the diffusion" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#808080;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="530" y="260" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-32" value="\( \begin{cases}dY_t=-f(X_t,Y_t,Z_t)dt+Z_t\cdot dW_t\\ Y_\tau=g(X_\tau),\quad Z_t=\sigma^\top\nabla u(X_t)\end{cases} \)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="660" y="260" width="260" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-33" value="\( u(x)=Y_0 \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="920" y="260" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-34" value="&lt;b&gt;Fokker–Planck&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="40" y="320" width="150" height="60" as="geometry" />
