        <mxCell id="XZhYp0Dp_hmtZWfRll8S-48" value="\( \begin{aligned}u(t,x)=\inf_{\alpha}\mathbb E\Big[&amp;amp;\int_t^T\! \ell(X^\alpha_s,\alpha_s)ds+h(X^\alpha_T)\,\Big]\end{aligned} \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
          <mxGeometry x="920" y="440" width="320" height="60" as="geometry" />
        </mxCell>
        <mxCell id="XZhYp0Dp_hmtZWfRll8S-49" value="\(&amp;nbsp;\mathcal{L}\varphi:=\tfrac12\operatorname{tr}\!\big(\sigma\sigma^\top\,D^2\varphi\big)+b\cdot\nabla\varphi \)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;spacing=4;" vertex="1" parent="XZhYp0Dp_hmtZWfRll8S-1">
