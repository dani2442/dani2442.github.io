        <mxCell id="exdRLjsYiT4XdOwJ8kc0-34" value="&lt;div&gt;\(\begin{align*}V(x,t):=\sup_\pi \mathbb E\left[\int_s^\infty e^{-\rho s} r(s,X_s,a_s)ds\,\middle|\,X_t=x\right] \end{align*}\)&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;strokeColor=none;" vertex="1" parent="1">
