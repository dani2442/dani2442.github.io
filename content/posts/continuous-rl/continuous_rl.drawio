        <mxCell id="exdRLjsYiT4XdOwJ8kc0-12" value="&lt;div&gt;\(\begin{align*}V(x):=\sup_\pi \mathbb E\left[\int_0^\infty e^{-\rho t} r(X_t,a_t)dt\,\middle|\,X_0=x\right] \end{align*}\)&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="700" y="260" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="exdRLjsYiT4XdOwJ8kc0-13" value="&lt;div&gt;&amp;nbsp;\(X_{n+1} \sim P(X_{n+1} |X_n, a_n) \)&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;strokeColor=none;" vertex="1" parent="1">
