        <mxCell id="exdRLjsYiT4XdOwJ8kc0-12" value="&lt;div&gt;\(\begin{align*}V(x):=\sup_\pi \mathbb E\left[\int_0^\infty e^{-\rho t} r(X_t,a_t)dt\,\middle|\,X_0=x\right] \end{align*}\)&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="700" y="260" width="310" height="65" as="geometry" />
        </mxCell>
        <mxCell id="exdRLjsYiT4XdOwJ8kc0-13" value="&lt;div&gt;&amp;nbsp;\(X_{n+1} \sim P(X_{n+1} |X_n, a_n) \)&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="447.5" y="210" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="exdRLjsYiT4XdOwJ8kc0-14" value="&lt;div&gt;&amp;nbsp;\(dX_t = f(X_t,a_t)\,dt + \Sigma(X_t,a_t)\,dW_t\)&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;strokeColor=none;" parent="1" vertex="1">
          <mxGeometry x="720" y="210" width="270" height="40" as="geometry" />
        </mxCell>
        <mxCell id="exdRLjsYiT4XdOwJ8kc0-15" value="&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;\( \begin{align*}\rho V=\max_{a\in\mathcal A}\left\{r(x,a)+ \nabla V^\top f + \tfrac{1}{2}\text{Tr}(\Sigma\Sigma^\top\nabla^2 V)\right\}&amp;nbsp; \end{align*} \)&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;rounded=1;fontSize=12;spacingTop=0;whiteSpace=wrap;noLabel=0;strokeColor=none;" parent="1" vertex="1">
